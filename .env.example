# 复制为 .env 即可生效（代码会自动加载，无需 python-dotenv）
#   macOS / Linux : cp .env.example .env
#   Windows       : copy .env.example .env
# 显式设置的环境变量优先级高于本文件。

# ════════════════════════════════════════════════════════════
# provider（谁来答） 与 offline（能不能联网）是两个**正交**的维度
# ════════════════════════════════════════════════════════════
#   deepseek : 便宜（约 Claude 的 1/20），无原生 citations / 无严格 schema
#   claude   : 原生字符级 citations + 严格 schema 约束
#   ollama   : 本地模型，完全离线免费
GRAPHRAG_LLM=deepseek

# 1 = 只读缓存，绝不发起网络调用。**面试演示设成 1。**
# 离线时 provider 配置保持不变 —— 能力位、模型名、请求体构造全部一致，
# 缓存键才对得上。（首版把 replay 做成第四个 provider，正是因此而失效。）
GRAPHRAG_OFFLINE=1

# ---- DeepSeek ----------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Claude ------------------------------------------------
# ANTHROPIC_API_KEY=
# GRAPHRAG_MODEL_EXTRACT=claude-haiku-4-5    # 抽取量大且不难 -> 便宜的
# GRAPHRAG_MODEL_ANSWER=claude-opus-5        # 生成要质量 -> 强的

# ---- 本地 Ollama -------------------------------------------
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# ════════════════════════════════════════════════════════════
# 向量模型
#   onnx : 模型随仓库分发，完全离线（推荐）
#   none : 关闭 dense，退化为纯 BM25（零依赖兜底，仍可完整演示）
GRAPHRAG_EMBED=onnx

# 缓存目录，默认 <repo>/data/llm_cache
# GRAPHRAG_CACHE=
